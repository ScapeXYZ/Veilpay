+    // VeilPay's offline machine session keeps a proposal alive between send and
+    // calculate. It cannot confirm/transmit, restore, or reveal private material.
+    if std::env::var("VEILPAY_MACHINE").as_deref() == Ok("1") {
+        use std::io::{BufRead, Write};
+        if cli_config.communications != Communications::DeliberateOffline {
+            return ExitCode::FAILURE;
+        }
+        for line in std::io::stdin().lock().lines() {
+            let result = line.map_err(|e| e.to_string()).and_then(|line| {
+                let tokens = shellwords::split(&line).map_err(|e| e.to_string())?;
+                let command = commands::parse_command_tokens(&tokens)?;
+                if !matches!(command, commands::CliCommand::Send { .. }
+                    | commands::CliCommand::Calculate | commands::CliCommand::Quit) {
+                    return Err("unsupported machine command".to_string());
+                }
+                send_request(Request::Command(command))
+            });
+            let (ok, output) = match result { Ok(s) => (true, s), Err(_) => (false, String::new()) };
+            println!("{}", json::object! { "ok" => ok, "output" => output }.dump());
+            let _ = std::io::stdout().flush();
+            if !ok { return ExitCode::FAILURE; }
+        }
+        return ExitCode::SUCCESS;
+    }
