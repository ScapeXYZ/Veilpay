# Browser uses the same-origin Next.js proxy to the actual mock Axum backend.
NEXT_PUBLIC_API_MODE=live
VEILPAY_BACKEND_URL=http://127.0.0.1:4000/api
# Set these explicitly in the backend process as well.
WALLET_BACKEND=mock
NETWORK=regtest
FRONTEND_ORIGIN=http://127.0.0.1:3100
BIND_ADDR=127.0.0.1:4000
