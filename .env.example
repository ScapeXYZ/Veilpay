# mock (default): in-process mock backend, persistent MOCK banner, no chain data.
# live: browser calls same-origin /api, proxied server-side to VEILPAY_BACKEND_URL.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE=/api
# Server-side only. Never prefix with NEXT_PUBLIC_.
VEILPAY_BACKEND_URL=http://127.0.0.1:8080
