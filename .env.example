# Browser uses the same-origin Next.js proxy to the mainnet read-only Axum backend.
NEXT_PUBLIC_API_MODE=live
VEILPAY_BACKEND_URL=http://127.0.0.1:4000/api
# This submission build observes mainnet only. `zingo` is deliberately
# broadcast-disabled; it does not sign, transmit, or create transactions.
WALLET_BACKEND=zingo
NETWORK=mainnet
FRONTEND_ORIGIN=http://localhost:3100
BIND_ADDR=127.0.0.1:4000
DATABASE_URL=sqlite://veilpay-mainnet.db
